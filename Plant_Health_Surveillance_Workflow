        "jsCode": "const googleDriveData = $('Upload file').first().json;\nconst historyResult = $('Qdrant Search').first().json;\nconst historicalRecords = historyResult?.result || [];\n\nconst fileId = googleDriveData.id;\nif (!fileId) throw new Error(\"No Google Drive file ID found.\");\n\nconst imageUrl = `https://drive.google.com/uc?export=download&id=${fileId}&confirm=t`;\n\nconst response = await this.helpers.httpRequest({\n  method: \"GET\",\n  url: imageUrl,\n  returnFullResponse: true,\n  encoding: \"arraybuffer\"\n});\n\nconst imageBase64 = Buffer.from(response.body).toString(\"base64\");\n\nlet historySummary = \"No previous records.\";\nif (historicalRecords.length > 0) {\n  const last = historicalRecords[0]?.payload;\n  historySummary = `${historicalRecords.length} past records. Last: ${last?.health_status || 'unknown'}, issue: ${last?.detected_issue || 'none'}`;\n}\n\nconst analysisPrompt = `You are a plant health expert. Analyze this plant photo carefully.\nLook at the leaves, stem, soil, and overall appearance.\nRespond ONLY with this exact JSON — no extra text:\n{\n  \"health\": \"healthy or warning or critical\",\n  \"issue\": \"specific visible problem, or none\",\n  \"moisture\": \"dry or moist or wet\",\n  \"humidity_issue\": true or false,\n  \"action\": \"water or fan or light or specialist or none\",\n  \"advice\": \"one clear sentence about what to do\"\n}\nPlant history: ${historySummary}`;\n\nconst ollamaBody = {\n  model: \"moondream\",\n  prompt: analysisPrompt,\n  images: [imageBase64],\n  stream: false\n};\n\nreturn {\n  json: {\n    image_url: imageUrl,\n    plant_id: googleDriveData.plant_id || \"plant_1\",\n    timestamp: new Date().toISOString(),\n    historical_records_count: historicalRecords.length,\n    ollama_body: JSON.stringify(ollamaBody)\n  }\n};"

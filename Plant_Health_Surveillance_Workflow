      "parameters": {
        "jsCode": "// ============================================\n// 1. GET OLLAMA RESPONSE\n// ============================================\n\nconst ollamaOutput = $input.first().json;\nconst responseText = ollamaOutput.response;\n\n// ============================================\n// 2. SET DEFAULT VALUES\n// ============================================\n\nlet analysisResult = {\n  health_status: \"unknown\",\n  detected_issue: \"none\",\n  soil_moisture: \"unknown\",\n  humidity_issue: false,\n  confidence: 0,\n  action_needed: \"none\",\n  recommendation: \"Unable to parse response\"\n};\n\n// ============================================\n// 3. PARSE JSON FROM OLLAMA RESPONSE\n// ============================================\n\ntry {\n  // Clean the response text - remove any non-JSON text\n  let cleanText = responseText;\n  \n  // Find JSON between curly braces\n  const jsonMatch = cleanText.match(/\\{[\\s\\S]*?\\}/);\n  if (jsonMatch) {\n    let jsonStr = jsonMatch[0];\n    \n    // Clean common issues\n    jsonStr = jsonStr.replace(/,(\\s*[}\\]])/g, '$1'); // Remove trailing commas\n    jsonStr = jsonStr.replace(/:\\s*\"([^\"]*?)\\/([^\"]*?)\\/([^\"]*?)\"/g, ':\"$1\"'); // Fix slashes in values\n    \n    const parsedJson = JSON.parse(jsonStr);\n    \n    // Helper function to clean values\n    const cleanValue = (val) => {\n      if (typeof val === 'string') {\n        // If value contains slashes, take only the first part\n        if (val.includes('/')) {\n          return val.split('/')[0].trim();\n        }\n        return val.trim();\n      }\n      return val;\n    };\n    \n    // Map with cleaning\n    analysisResult = {\n      health_status: cleanValue(parsedJson.health || parsedJson.health_status || \"unknown\"),\n      detected_issue: cleanValue(parsedJson.issue || parsedJson.detected_issue || \"none\"),\n      soil_moisture: cleanValue(parsedJson.moisture || parsedJson.soil_moisture || \"unknown\"),\n      humidity_issue: parsedJson.humidity_issue === true,\n      confidence: typeof parsedJson.confidence === 'number' ? parsedJson.confidence : \n                 (typeof parsedJson.confidence === 'string' ? parseFloat(parsedJson.confidence) || 0 : 0),\n      action_needed: cleanValue(parsedJson.action || parsedJson.action_needed || \"none\"),\n      recommendation: cleanValue(parsedJson.advice || parsedJson.recommendation || \"No recommendation\")\n    };\n    \n    console.log(\"Parsed:\", analysisResult);\n  }\n} catch (e) {\n  console.log(\"JSON parsing error:\", e.message);\n  console.log(\"Raw response:\", responseText);\n}\n\n// ============================================\n// 4. VALIDATE AND CLEAN VALUES\n// ============================================\n\n// Ensure action_needed is a valid value\nconst validActions = [\"water\", \"fan\", \"light\", \"specialist\", \"none\", \"retake_photo\"];\nif (!validActions.includes(analysisResult.action_needed)) {\n  analysisResult.action_needed = \"none\";\n  console.log(`Reset invalid action to \"none\"`);\n}\n\n// Ensure health_status is valid\nconst validStatuses = [\"healthy\", \"warning\", \"critical\", \"low_confidence\", \"unknown\"];\nif (!validStatuses.includes(analysisResult.health_status)) {\n  analysisResult.health_status = \"unknown\";\n}\n\n// Convert confidence\nif (analysisResult.confidence > 0 && analysisResult.confidence <= 1) {\n  analysisResult.confidence = analysisResult.confidence * 100;\n}\nif (analysisResult.confidence > 100) {\n  analysisResult.confidence = 100;\n}\nif (analysisResult.confidence < 0) {\n  analysisResult.confidence = 0;\n}\n\n// Validate based on confidence\nif (analysisResult.confidence < 50) {\n  analysisResult.health_status = \"low_confidence\";\n  analysisResult.recommendation = \"⚠️ Low confidence. Please retake photo with better lighting.\";\n  analysisResult.action_needed = \"retake_photo\";\n}\n\nconsole.log(`Final: ${analysisResult.health_status}, ${analysisResult.confidence}%, Action: ${analysisResult.action_needed}`);\n\n// ============================================\n// 5. RETURN DATA\n// ============================================\n\nreturn {\n  json: {\n    plant_id: $json.plant_id || \"plant_1\",\n    image_url: $json.image_url || \"\",\n    timestamp: new Date().toISOString(),\n    health_status: analysisResult.health_status,\n    detected_issue: analysisResult.detected_issue,\n    soil_moisture: analysisResult.soil_moisture,\n    humidity_issue: analysisResult.humidity_issue,\n    confidence: analysisResult.confidence,\n    action_needed: analysisResult.action_needed,\n    recommendation: analysisResult.recommendation,\n    raw_ollama_response: responseText\n  }\n};"
      },

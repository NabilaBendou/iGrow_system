        "jsCode": "// Get both items from the Merge Node (Append mode)\nconst items = $input.all();\n\nconsole.log(`📦 Received ${items.length} items from Merge Node`);\n\nlet temperature = null;\nlet humidity = null;\n\n// Process each item\nfor (const item of items) {\n  const data = item.json;\n  \n  console.log(`Processing entity: ${data.entity_id}`);\n  console.log(`State value: ${data.state}`);\n  \n  // Check for temperature sensor\n  if (data.entity_id === 'sensor.greenhouse_sensor_greenhouse_temperature_2') {\n    temperature = parseFloat(data.state);\n    console.log(`🌡️ Temperature found: ${temperature}°C`);\n  }\n  \n  // Check for humidity sensor\n  if (data.entity_id === 'sensor.greenhouse_sensor_greenhouse_humidity_2') {\n    humidity = parseFloat(data.state);\n    console.log(`💧 Humidity found: ${humidity}%`);\n  }\n}\n\n// Return combined result\nreturn {\n  temperature: temperature,\n  humidity: humidity,\n  temperature_celsius: temperature,\n  humidity_percent: humidity,\n  both_readings_available: (temperature !== null && humidity !== null),\n  timestamp: new Date().toISOString(),\n  summary: `Temperature: ${temperature}°C, Humidity: ${humidity}%`\n};"

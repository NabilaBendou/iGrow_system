      "parameters": {
        "jsCode": "// ============================================\n// CODE NODE 2: Detect Sirocco & Weather Conditions\n// ============================================\n\nconst sensorInput = $input.first().json;\nlet sensorData = sensorInput.sensor || {};\n\nlet weatherData = null;\ntry {\n  weatherData = $node['Get External Weather']?.json;\n} catch (e) {\n  console.log(\"No weather data available\");\n}\n\n// ========== FORCE TEST VALUES - REMOVE AFTER TESTING ==========\nconst FORCE_TEST = true;\n\nif (FORCE_TEST) {\n  console.log(\"⚠️⚠️⚠️ FORCE TEST MODE ACTIVE ⚠️⚠️⚠️\");\n  \n  sensorData = {\n    light: 400,\n    presence: \"ON\",\n    temperature: 35,\n    humidity: 25,\n    windSpeed: 5.5,\n    soilMoisture: 45,\n    source: \"mqtt_forced_test\"\n  };\n  \n  weatherData = {\n    main: { temp: 35, humidity: 25 },\n    wind: { speed: 5.5 },\n    weather: [{ main: \"Clear\", description: \"clear sky\" }]\n  };\n  \n  console.log(\"Forced Sensor Data:\", sensorData);\n  console.log(\"Forced Weather Data:\", weatherData);\n}\n// ========== END FORCE TEST ==========\n\nconsole.log(\"=== INCOMING DATA ===\");\nconsole.log(\"Sensor Data:\", sensorData);\nconsole.log(\"Weather Data Available:\", weatherData ? \"Yes\" : \"No\");\nif (weatherData) {\n  console.log(\"Weather Temp:\", weatherData.main?.temp);\n  console.log(\"Weather Humidity:\", weatherData.main?.humidity);\n  console.log(\"Weather Wind Speed:\", weatherData.wind?.speed);\n  console.log(\"Weather Condition:\", weatherData.weather?.[0]?.main);\n}\n\n// ============================================\n// PRIORITIZE: Use Sensor Data FIRST, Weather as FALLBACK\n// ============================================\n\nlet temperature = sensorData.temperature;\nlet humidity = sensorData.humidity;\nlet windSpeed = sensorData.windSpeed;\nlet soilMoisture = sensorData.soilMoisture ?? null;\nlet dataSource = \"sensor\";\n\nif (temperature === null && weatherData?.main?.temp !== undefined) {\n  temperature = weatherData.main.temp;\n  dataSource = \"weather\";\n}\n\nif (humidity === null && weatherData?.main?.humidity !== undefined) {\n  humidity = weatherData.main.humidity;\n  dataSource = \"weather\";\n}\n\nif (windSpeed === null && weatherData?.wind?.speed !== undefined) {\n  windSpeed = weatherData.wind.speed;\n  dataSource = \"weather\";\n}\n\nconst weatherCondition = weatherData?.weather?.[0]?.main || null;\nconst weatherDescription = weatherData?.weather?.[0]?.description || null;\n\nconsole.log(\"=== FINAL VALUES ===\");\nconsole.log(\"Temperature:\", temperature);\nconsole.log(\"Humidity:\", humidity);\nconsole.log(\"Wind Speed:\", windSpeed);\nconsole.log(\"Soil Moisture:\", soilMoisture);\nconsole.log(\"Weather Condition:\", weatherCondition);\n\n// ============================================\n// DETECT ALERT CONDITIONS\n// ============================================\n\nlet isSirocco = false;\nlet extremeHeat = false;\nlet moderateHeat = false;\nlet drought = false;\nlet soilDry = false;\n\nif (temperature !== null && humidity !== null) {\n  extremeHeat = temperature > 35;\n  moderateHeat = temperature > 30;\n  drought = humidity < 30;\n\n  if (temperature > 30 && humidity < 30) {\n    const hasStrongWind = (windSpeed !== null && windSpeed > 4.17);\n    const isClearSky = (weatherCondition === 'Clear') || (weatherCondition === null);\n    isSirocco = hasStrongWind && isClearSky;\n  }\n}\n\nif (soilMoisture !== null) {\n  soilDry = soilMoisture < 30;\n}\n\nconsole.log(\"=== ALERT CONDITIONS ===\");\nconsole.log(\"Extreme Heat:\", extremeHeat);\nconsole.log(\"Moderate Heat:\", moderateHeat);\nconsole.log(\"Drought:\", drought);\nconsole.log(\"Sirocco:\", isSirocco);\nconsole.log(\"Soil Dry:\", soilDry);\n\n// ============================================\n// GENERATE ALERT MESSAGES\n// ============================================\n\nconst alertMessages = [];\n\nif (isSirocco) {\n  alertMessages.push(`⚠️ SIROCCO ALERT! Hot, dry wind from Sahara! Temp: ${temperature}°C, Humidity: ${humidity}%, Wind: ${windSpeed} m/s`);\n}\nif (extremeHeat) {\n  alertMessages.push(`🔥 EXTREME HEAT! Temperature ${temperature}°C above 35°C! Humidity: ${humidity}%`);\n}\nif (drought) {\n  alertMessages.push(`💧 DROUGHT ALERT! Humidity ${humidity}% below 30%! Temperature: ${temperature}°C`);\n}\nif (soilDry) {\n  alertMessages.push(`🌱 SOIL DRY ALERT! Soil moisture ${soilMoisture}% below 30%! Water plants now.`);\n}\nif (moderateHeat && !extremeHeat && !isSirocco) {\n  alertMessages.push(`🌡️ MODERATE HEAT: Temperature ${temperature}°C above 30°C, Humidity: ${humidity}%`);\n}\n\nlet priority = \"normal\";\nlet alertType = \"normal\";\n\nif (isSirocco) {\n  priority = \"critical\";\n  alertType = \"sirocco\";\n} else if (extremeHeat) {\n  priority = \"high\";\n  alertType = \"extreme_heat\";\n} else if (drought) {\n  priority = \"medium\";\n  alertType = \"drought\";\n} else if (soilDry) {\n  priority = \"medium\";\n  alertType = \"soil_dry\";\n} else if (moderateHeat) {\n  priority = \"low\";\n  alertType = \"moderate_heat\";\n}\n\n// ============================================\n// GENERATE RECOMMENDATIONS\n// ============================================\n\nlet recommendations = null;\n\nif (isSirocco) {\n  recommendations = `🚨 SIROCCO EMERGENCY (Temp: ${temperature}°C, Humidity: ${humidity}%, Wind: ${windSpeed} m/s) | Close all greenhouse vents immediately | Activate full misting system | Close all shading curtains | Monitor plants for heat stress | Check water levels | Consider moving sensitive plants`;\n} else if (extremeHeat) {\n  recommendations = `🔥 HEAT WAVE (Temp: ${temperature}°C, Humidity: ${humidity}%) | Increase ventilation | Water plants in early morning | Check soil moisture daily | Consider temporary shading | Monitor temperature hourly`;\n} else if (drought) {\n  recommendations = `💧 DROUGHT CONDITIONS (Humidity: ${humidity}%, Temp: ${temperature}°C) | Increase misting frequency | Check soil moisture deeply | Water plants thoroughly | Monitor for wilting leaves | Mulch to retain moisture`;\n} else if (soilDry) {\n  recommendations = `🌱 DRY SOIL (Moisture: ${soilMoisture}%) | Water plants immediately | Check irrigation system | Monitor soil moisture hourly | Ensure drainage is not blocked`;\n} else if (moderateHeat) {\n  recommendations = `🌡️ WARM CONDITIONS (Temp: ${temperature}°C) | Monitor temperature | Ensure adequate ventilation | Normal watering schedule | Check plants daily`;\n}\n\nlet safeRecommendations = recommendations;\nlet safeAlertMessage = alertMessages.length > 0 ? alertMessages.join(\" | \") : \"✅ CONDITIONS OPTIMALES: Tout est normal\";\n\nif (safeRecommendations) {\n  safeRecommendations = safeRecommendations.replace(/\\n/g, ' ').replace(/\\r/g, ' ');\n}\n\n// ============================================\n// DETERMINE ACTIONS\n// ============================================\n\nconst actions = {\n  fan: (extremeHeat || isSirocco) ? \"on\" : \"off\",\n  shading: (extremeHeat || isSirocco) ? \"close\" : \"auto\",\n  misting: (drought || isSirocco) ? \"on\" : \"off\",\n  water: soilDry ? \"on\" : \"off\",\n  ventilation: (extremeHeat || isSirocco) ? \"max\" : \"normal\",\n  alert_level: isSirocco ? \"critical\" : (extremeHeat ? \"high\" : (drought || soilDry ? \"medium\" : \"normal\"))\n};\n\n// ============================================\n// RETURN COMPLETE DATA\n// ============================================\n\nconst currentTime = new Date().toISOString();\n\nreturn {\n  sensor: {\n    light: sensorData.light,\n    presence: sensorData.presence,\n    temperature: sensorData.temperature,\n    humidity: sensorData.humidity,\n    windSpeed: sensorData.windSpeed,\n    soilMoisture: soilMoisture,\n    source: sensorData.source || \"mqtt\"\n  },\n\n  weather: {\n    temperature: weatherData?.main?.temp || null,\n    humidity: weatherData?.main?.humidity || null,\n    windSpeed: weatherData?.wind?.speed || null,\n    condition: weatherCondition,\n    description: weatherDescription,\n    source: weatherData ? \"openweathermap\" : null\n  },\n\n  combined: {\n    temperature: temperature,\n    humidity: humidity,\n    windSpeed: windSpeed,\n    soilMoisture: soilMoisture,\n    dataSource: dataSource,\n    hasSensorData: sensorData.temperature !== null || sensorData.humidity !== null\n  },\n\n  alert: {\n    isActive: (priority !== \"normal\"),\n    priority: priority,\n    type: alertType,\n    level: priority === \"critical\" ? \"critical\" : (priority === \"high\" ? \"high\" : \"info\"),\n    message: safeAlertMessage,\n    conditions: {\n      isSirocco: isSirocco,\n      extremeHeat: extremeHeat,\n      moderateHeat: moderateHeat,\n      drought: drought,\n      soilDry: soilDry,\n      temperature: temperature,\n      humidity: humidity,\n      windSpeed: windSpeed,\n      soilMoisture: soilMoisture,\n      weatherCondition: weatherCondition\n    }\n  },\n\n  recommendations: safeRecommendations,\n  actions: actions,\n  timestamp: currentTime,\n  updatedAt: currentTime,\n  testMode: FORCE_TEST ? \"active\" : \"inactive\"\n};"
      },

      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst haUrl = \"http://10.254.79.161:8123\";\nconst haToken = \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiIzZjc1NzE1NmRmMzU0OWFhOWI5ZjE1OWEyMDYwMjVlYSIsImlhdCI6MTc3NDM2OTExNCwiZXhwIjoyMDg5NzI5MTE0fQ.d3Z7lDl5f9hOeJvfiV-mt6Vhpn_gKUb3qol0hAYj3vI\";\n\nconst headers = {\n  \"Authorization\": `Bearer ${haToken}`,\n  \"Content-Type\": \"application/json\"\n};\n\n// Calculate alert level percentage based on priority\nlet alertLevel = 0;\nif (data.alert?.priority === 'critical') alertLevel = 95;\nelse if (data.alert?.priority === 'high') alertLevel = 75;\nelse if (data.alert?.priority === 'medium') alertLevel = 50;\nelse if (data.alert?.priority === 'low') alertLevel = 25;\nelse alertLevel = 0;\n\n// Current timestamp for alerts\nconst currentTimestamp = new Date().toISOString();\nconst formattedTime = new Date().toLocaleString();\n\n// Extract recommendation from data\nconst recommendation = data.recommendations || data.alert?.message || data.recommendation || \"No recommendation available\";\n\n// Extract detected labels\nconst detectedLabels = data.sensor ? Object.keys(data.sensor).filter(k => data.sensor[k] !== null).join(\", \") : \"none\";\n\nconst updates = [\n  // ============================================\n  // AI ALERT ENTITIES (Matching your helper names)\n  // ============================================\n  \n  // Critical Alert Level (input_number)\n  {\n    url: `${haUrl}/api/services/input_number/set_value`,\n    body: {\n      entity_id: \"input_number.critical_alert_level\",\n      value: alertLevel\n    }\n  },\n  \n  // AI Alert Level (input_number)\n  {\n    url: `${haUrl}/api/services/input_number/set_value`,\n    body: {\n      entity_id: \"input_number.ai_alert_level\",\n      value: alertLevel\n    }\n  },\n  \n  // AI Alert Priority (input_text)\n  {\n    url: `${haUrl}/api/services/input_text/set_value`,\n    body: {\n      entity_id: \"input_text.ai_alert_priority\",\n      value: String(data.alert?.priority ?? \"normal\")\n    }\n  },\n  \n  // AI Alert Type (input_text)\n  {\n    url: `${haUrl}/api/services/input_text/set_value`,\n    body: {\n      entity_id: \"input_text.ai_alert_type\",\n      value: String(data.alert?.type ?? \"sirocco\")\n    }\n  },\n  \n  // Alert Timestamp (input_text)\n  {\n    url: `${haUrl}/api/services/input_text/set_value`,\n    body: {\n      entity_id: \"input_text.alert_timestamp\",\n      value: formattedTime\n    }\n  },\n  \n  // AI Recommendation (input_text)\n  {\n    url: `${haUrl}/api/services/input_text/set_value`,\n    body: {\n      entity_id: \"input_text.ai_recommendation\",\n      value: String(recommendation).substring(0, 255)\n    }\n  },\n  \n  // Confidence Score (input_number)\n  {\n    url: `${haUrl}/api/services/input_number/set_value`,\n    body: {\n      entity_id: \"input_number.plant_confidence\",\n      value: data.confidence || data.workflow_confidence || 98\n    }\n  },\n  \n  // Detected Labels (input_text)\n  {\n    url: `${haUrl}/api/services/input_text/set_value`,\n    body: {\n      entity_id: \"input_text.plant_labels\",\n      value: detectedLabels\n    }\n  },\n  \n  // Plant Alert Level (input_text)\n  {\n    url: `${haUrl}/api/services/input_text/set_value`,\n    body: {\n      entity_id: \"input_text.plant_alert_level\",\n      value: String(data.alert?.priority ?? \"normal\")\n    }\n  },\n  \n  // Plant Alert Message (input_text)\n  {\n    url: `${haUrl}/api/services/input_text/set_value`,\n    body: {\n      entity_id: \"input_text.plant_alert_message\",\n      value: String(data.alert?.message ?? \"Sirocco conditions detected\").substring(0, 255)\n    }\n  },\n  \n  // Plant Health Status (input_text)\n  {\n    url: `${haUrl}/api/services/input_text/set_value`,\n    body: {\n      entity_id: \"input_text.plant_health_status\",\n      value: alertLevel > 70 ? \"Critical\" : alertLevel > 40 ? \"Warning\" : \"Normal\"\n    }\n  },\n  \n  // Plant Tip (input_text)\n  {\n    url: `${haUrl}/api/services/input_text/set_value`,\n    body: {\n      entity_id: \"input_text.input_text_plant_tip\",\n      value: String(data.tip || recommendation || \"Monitor soil moisture levels\").substring(0, 255)\n    }\n  },\n  \n  // ============================================\n  // SENSOR DATA ENTITIES\n  // ============================================\n  \n  // Greenhouse Light Level (input_number)\n  {\n    url: `${haUrl}/api/services/input_number/set_value`,\n    body: {\n      entity_id: \"input_number.greenhouse_light_level\",\n      value: data.sensor?.light ?? 0\n    }\n  },\n  \n  // Greenhouse Presence (input_boolean)\n  {\n    url: `${haUrl}/api/services/input_boolean/${data.sensor?.presence === \"ON\" ? \"turn_on\" : \"turn_off\"}`,\n    body: {\n      entity_id: \"input_boolean.greenhouse_presence\"\n    }\n  },\n  \n  // Soil Moisture (input_number)\n  {\n    url: `${haUrl}/api/services/input_number/set_value`,\n    body: {\n      entity_id: \"input_number.soil_moisture\",\n      value: data.sensor?.soilMoisture ?? 45\n    }\n  },\n  \n  // Temperature (counter - using set_value if available, or create state)\n  {\n    url: `${haUrl}/api/states/counter.temperature`,\n    body: {\n      state: String(data.combined?.temperature ?? data.sensor?.temperature ?? 35),\n      attributes: { unit_of_measurement: \"°C\", friendly_name: \"Temperature\" }\n    }\n  },\n  \n  // Humidity (counter)\n  {\n    url: `${haUrl}/api/states/counter.humidity`,\n    body: {\n      state: String(data.combined?.humidity ?? data.sensor?.humidity ?? 25),\n      attributes: { unit_of_measurement: \"%\", friendly_name: \"Humidity\" }\n    }\n  },\n  \n  // ============================================\n  // CONTROL ENTITIES (Virtual)\n  // ============================================\n  \n  // Fan Control (input_boolean)\n  {\n    url: `${haUrl}/api/services/input_boolean/${data.actions?.fan === \"on\" ? \"turn_on\" : \"turn_off\"}`,\n    body: {\n      entity_id: \"input_boolean.fan_control\"\n    }\n  },\n  \n  // fan_virtual (input_boolean)\n  {\n    url: `${haUrl}/api/services/input_boolean/${data.actions?.fan === \"on\" ? \"turn_on\" : \"turn_off\"}`,\n    body: {\n      entity_id: \"input_boolean.fan_virtual\"\n    }\n  },\n  \n  // Pump Control (input_boolean)\n  {\n    url: `${haUrl}/api/services/input_boolean/${data.actions?.misting === \"on\" ? \"turn_on\" : \"turn_off\"}`,\n    body: {\n      entity_id: \"input_boolean.pump_control\"\n    }\n  },\n  \n  // pump_virtual (input_boolean)\n  {\n    url: `${haUrl}/api/services/input_boolean/${data.actions?.misting === \"on\" ? \"turn_on\" : \"turn_off\"}`,\n    body: {\n      entity_id: \"input_boolean.pump_virtual\"\n    }\n  },\n  \n  // light_virtual (input_boolean)\n  {\n    url: `${haUrl}/api/services/input_boolean/turn_${data.sensor?.light > 300 ? \"on\" : \"off\"}`,\n    body: {\n      entity_id: \"input_boolean.light_virtual\"\n    }\n  },\n  \n  // ============================================\n  // DATETIME ENTITIES\n  // ============================================\n  \n  // Last Analysis (input_datetime)\n  {\n    url: `${haUrl}/api/services/input_datetime/set_datetime`,\n    body: {\n      entity_id: \"input_datetime.last_analysis\",\n      datetime: currentTimestamp.substring(0, 19)\n    }\n  }\n];\n\n// Send all updates to Home Assistant\nfor (const update of updates) {\n  try {\n    await this.helpers.httpRequest({\n      method: \"POST\",\n      url: update.url,\n      headers: headers,\n      body: JSON.stringify(update.body)\n    });\n    console.log(`✅ Updated: ${update.url}`);\n  } catch (e) {\n    console.log(`❌ Failed: ${update.url} - ${e.message}`);\n  }\n}\n\nconsole.log(\"✅ All HA entities updated successfully\");\n\n// Return the data for the next node\nreturn { \n  json: {\n    ...data,\n    ha_updates_completed: true,\n    alert_level: alertLevel,\n    timestamp: currentTimestamp\n  }\n};"
      },

      "parameters": {
        "jsCode": "// Get data from Merge node or directly from previous node\nconst items = $input.all();\n\n// Find current reading (looking for water_level instead of level)\nlet currentLevel = null;\nlet historyData = [];\n\nfor (const item of items) {\n  // Look for water_level from your webhook/Edit Fields node\n  if (item.json.water_level !== undefined && typeof item.json.water_level === 'number') {\n    currentLevel = item.json.water_level;\n  } \n  // Also check for 'level' if you rename it later\n  else if (item.json.level !== undefined && typeof item.json.level === 'number') {\n    currentLevel = item.json.level;\n  }\n  // Look for history data from Google Sheets\n  else if (item.json.Timestamp !== undefined || item.json['Water Level (%)'] !== undefined) {\n    historyData.push(item.json);\n  }\n}\n\n// If no current level found, check $json directly\nif (currentLevel === null && $json.water_level !== undefined) {\n  currentLevel = $json.water_level;\n}\n\nif (currentLevel === null && $json.level !== undefined) {\n  currentLevel = $json.level;\n}\n\n// If STILL no current level, check if $json itself is a number\nif (currentLevel === null && typeof $json === 'number') {\n  currentLevel = $json;\n}\n\n// FALLBACK: If no level at all, use a test value (change to 0 for empty tank)\nif (currentLevel === null || isNaN(currentLevel)) {\n  currentLevel = 75;  // Default test value - CHANGE THIS TO YOUR ACTUAL LEVEL\n}\n\n// Extract levels from history (Google Sheets data)\nlet levels = [];\nfor (const row of historyData) {\n  const levelValue = row['Water Level (%)'] || row['Water Level'] || row.water_level || row.level || row.currentLevel;\n  if (levelValue !== undefined && !isNaN(parseFloat(levelValue))) {\n    levels.push(parseFloat(levelValue));\n  }\n}\n\n// Calculate consumption rate from history (if available)\nlet consumptionRate = 5;  // Default: 5% per hour\nlet predictedEmptyHours = currentLevel / consumptionRate;\nlet status = \"default_prediction\";\n\n// If we have history, calculate real consumption rate\nif (levels.length >= 2) {\n  // Get the oldest level from history\n  const oldestLevel = levels[0];\n  const newestLevel = levels[levels.length - 1];\n  const totalDrop = oldestLevel - newestLevel;\n  \n  // Assume history spans 24 hours (adjust based on your actual data)\n  const hoursSpan = 24;\n  const realRate = totalDrop / hoursSpan;\n  \n  if (realRate > 0) {\n    consumptionRate = parseFloat(realRate.toFixed(2));\n    predictedEmptyHours = currentLevel / realRate;\n    status = \"history_based_prediction\";\n  }\n}\n\n// Add safety check for predictedEmptyHours (avoid infinity)\nif (!isFinite(predictedEmptyHours) || predictedEmptyHours < 0) {\n  predictedEmptyHours = 0;\n  status = \"no_consumption\";\n}\n\n// Generate human-readable time\nconst hours = Math.floor(predictedEmptyHours);\nconst minutes = Math.floor((predictedEmptyHours - hours) * 60);\n\nlet emptyTimeMessage = \"Never (no consumption detected)\";\nif (predictedEmptyHours > 0 && predictedEmptyHours < 1000) {\n  if (hours > 0) {\n    emptyTimeMessage = `${hours} hour${hours !== 1 ? 's' : ''} and ${minutes} minute${minutes !== 1 ? 's' : ''}`;\n  } else {\n    emptyTimeMessage = `${minutes} minute${minutes !== 1 ? 's' : ''}`;\n  }\n}\n\n// Return results\nreturn {\n  current_level: currentLevel,\n  consumption_rate_per_hour: consumptionRate,\n  predicted_empty_hours: parseFloat(predictedEmptyHours.toFixed(1)),\n  predicted_empty_time: emptyTimeMessage,\n  history_points_used: levels.length,\n  prediction_status: status,\n  needs_water: currentLevel < 20,\n  urgency: currentLevel < 10 ? \"IMMEDIATE\" : currentLevel < 20 ? \"HIGH\" : currentLevel < 35 ? \"MEDIUM\" : \"LOW\",\n  alert_message: currentLevel < 20 ? `⚠️ CRITICAL: Water level at ${currentLevel}%. Tank will be empty in ${emptyTimeMessage}!` : `Water level: ${currentLevel}%. ${emptyTimeMessage} until empty.`\n};"
      },

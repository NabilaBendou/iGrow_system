        "jsCode": "// Get water level from the input (from Code in JavaScript node)\nlet currentLevel = null;\n\n// Check various possible field names from the previous node\nif ($json.water_level !== undefined && typeof $json.water_level === 'number') {\n  currentLevel = $json.water_level;\n} else if ($json.level !== undefined && typeof $json.level === 'number') {\n  currentLevel = $json.level;\n} else if ($json.current_level !== undefined && typeof $json.current_level === 'number') {\n  currentLevel = $json.current_level;\n}\n\n// If no level found, default to 0 (tank empty)\nif (currentLevel === null || isNaN(currentLevel)) {\n  currentLevel = 0;\n}\n\n// Default consumption rate (5% per hour)\nlet consumptionRate = 5;\nlet predictedEmptyHours = currentLevel / consumptionRate;\nlet status = \"default_prediction\";\n\n// Safety checks\nif (!isFinite(predictedEmptyHours) || predictedEmptyHours < 0) {\n  predictedEmptyHours = 0;\n  status = \"no_consumption\";\n}\n\n// Format time message\nconst hours = Math.floor(predictedEmptyHours);\nconst minutes = Math.floor((predictedEmptyHours - hours) * 60);\n\nlet emptyTimeMessage = \"Never (no consumption detected)\";\nif (predictedEmptyHours > 0 && predictedEmptyHours < 1000) {\n  if (hours > 0) {\n    emptyTimeMessage = `${hours} hour${hours !== 1 ? 's' : ''} and ${minutes} minute${minutes !== 1 ? 's' : ''}`;\n  } else {\n    emptyTimeMessage = `${minutes} minute${minutes !== 1 ? 's' : ''}`;\n  }\n}\n\n// Return results\nreturn {\n  current_level: currentLevel,\n  consumption_rate_per_hour: consumptionRate,\n  predicted_empty_hours: parseFloat(predictedEmptyHours.toFixed(1)),\n  predicted_empty_time: emptyTimeMessage,\n  needs_water: currentLevel < 20,\n  urgency: currentLevel < 10 ? \"IMMEDIATE\" : currentLevel < 20 ? \"HIGH\" : currentLevel < 35 ? \"MEDIUM\" : \"LOW\",\n  alert_message: currentLevel < 20 ? `⚠️ CRITICAL: Water level at ${currentLevel}%. Tank will be empty in ${emptyTimeMessage}!` : `Water level: ${currentLevel}%. ${emptyTimeMessage} until empty.`,\n  \n  // For Google Sheets compatibility\n  consumptionRate: consumptionRate,\n  level: currentLevel,\n  \n  // Keep pump status from previous node if available\n  pump_status: $json.pump_status || \"UNKNOWN\",\n  timestamp: $json.timestamp || new Date().toISOString()\n};"
